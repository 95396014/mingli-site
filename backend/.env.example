# ================================================
# 本地开发环境变量模板（复制本文件为 .env 再填值）
# 重要：.env 已在 .gitignore 中，绝对不能提交到 GitHub！
#
# 生产托管（Railway / Koyeb / Vercel）请在托管平台的 Variables / Environment 页面
# 填入同样的键值，不要把真实的密钥写进仓库。
# ================================================

# 后端端口（本地开发建议 3001；Railway/Koyeb 托管平台会自动注入 PORT，不用管）
DEV_PORT=3001

# JWT 登录签名密钥（任何足够长的随机字符串都行，不要泄露给任何人）
# 建议长度：至少 32 位，字母+数字+符号混合
JWT_SECRET=请替换成一长串随机字母数字，比如 mingli_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API 配置（https://platform.deepseek.com/ 申请）
DEEPSEEK_API_KEY=sk-你的DeepSeekKey填这里

# 可选：自定义 API 地址和模型（默认就好，只有兼容 OpenAI 协议的其他平台才改）
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# 可选：免费用户每日 AI 使用次数限制（默认 0 次 = 免费用户不能使用 AI，必须付费）
# 说明：
#   - 填 0 ：免费用户一次 AI 都不能用，必须开通会员或购买单次卡（你要求的默认策略）
#   - 填 3 ：免费用户每天可以体验 3 次，之后再提示付费
# FREE_DAILY_LIMIT=0

# ================================================
# 💚 微信支付配置（Native 扫码付）
# ================================================
# 在微信商户平台「账户中心 → 商户信息」获取商户号
WXPAY_MCHID=1749599906

# 商户 API 证书序列号（在「API 安全 → 证书」里查看，约 40 位字符串）
WXPAY_PUBLIC_KEY_ID=请替换成你的API证书序列号

# APIv3 密钥（32位，你在「API 安全」页面自己设置的，不能丢！）
WXPAY_API_V3_KEY=请替换成32位的APIv3密钥

# Native 支付回调地址（商户平台「开发配置 → Native 支付」里填这个）
# ⚠️ 必须用 https，路径必须和后端路由一致：/api/vip/order/wxpay-notify
WXPAY_NOTIFY_URL=https://mingli-site-production.up.railway.app/api/vip/order/wxpay-notify

# Native 支付可选 AppID（如果你没绑定公众号，留空即可）
# WXPAY_APPID=wx1234567890abcdef

# ⚠️ 商户 API 私钥文件（apiclient_key.pem）必须放到：
#   backend/cert/apiclient_key.pem
# 这个文件不要提交到 GitHub，已在 .gitignore 里
# ================================================
# 这里我给你设置成：账号 13148219992，密码 Hui13148219992
# ⚠️ 本地开发：复制本文件为 backend/.env 后，取消下面两行的注释即可。
# ⚠️ Railway / 其他托管平台：在 Variables 页面新增 2 条变量：
#      ADMIN_USERNAME = 13148219992
#      ADMIN_PASSWORD = Hui13148219992
#    保存后 Apply / Redeploy，服务启动时会自动创建/重置这个管理员账号，
#    密码会用 bcrypt 加密入库，日志里不会打印明文。
# ⚠️ 数据库里残留的旧默认 admin/admin123 会被自动降级为普通用户，
#    防止公开站点被别人用弱密码登录后台。
#
# ADMIN_USERNAME=13148219992
# ADMIN_PASSWORD=Hui13148219992
